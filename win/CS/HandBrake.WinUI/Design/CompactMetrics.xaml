<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Application density tokens, in effective pixels. Keep fonts scalable. -->
    <x:Double x:Key="HBControlMinHeight">28</x:Double>
    <x:Double x:Key="HBBodyFontSize">14</x:Double>
    <x:Double x:Key="HBCaptionFontSize">12</x:Double>
    <x:Double x:Key="HBSectionFontSize">17</x:Double>
    <x:Double x:Key="HBIconSize">16</x:Double>
    <x:Double x:Key="HBIconButtonSize">28</x:Double>
    <x:Double x:Key="HBChoiceRowMinHeight">32</x:Double>
    <x:Double x:Key="HBMediaSourceMinHeight">68</x:Double>
    <x:Double x:Key="HBMediaSourceIconSize">20</x:Double>
    <x:Double x:Key="HBSpaceTight">4</x:Double>
    <x:Double x:Key="HBSpaceRow">8</x:Double>
    <x:Double x:Key="HBSpaceGroup">12</x:Double>
    <x:Double x:Key="HBFormWideBreakpoint">900</x:Double>
    <x:Double x:Key="HBFormTwoColumnBreakpoint">560</x:Double>
    <Thickness x:Key="HBButtonPadding">10,3,10,3</Thickness>
    <Thickness x:Key="HBInputPadding">10,3,10,3</Thickness>
    <Thickness x:Key="HBComboBoxPadding">10,3,0,3</Thickness>
    <Thickness x:Key="HBIconButtonPadding">4</Thickness>
    <Thickness x:Key="HBMenuItemPadding">12,3,12,3</Thickness>
    <Thickness x:Key="HBCardPadding">12</Thickness>
    <Thickness x:Key="HBFormRowMargin">0,4,0,8</Thickness>
    <CornerRadius x:Key="HBCardCornerRadius">8</CornerRadius>

    <!-- Native NumberBox uses TextControlThemeMinHeight/Padding for its inner
         TextBox. Change these resources, not NumberBox's native template. -->
    <StaticResource x:Key="ControlContentThemeFontSize" ResourceKey="HBBodyFontSize"/>
    <StaticResource x:Key="ContentControlFontSize" ResourceKey="HBBodyFontSize"/>
    <StaticResource x:Key="TextControlThemeMinHeight" ResourceKey="HBControlMinHeight"/>
    <StaticResource x:Key="TextControlThemePadding" ResourceKey="HBInputPadding"/>
    <StaticResource x:Key="ComboBoxMinHeight" ResourceKey="HBControlMinHeight"/>
    <StaticResource x:Key="ComboBoxPadding" ResourceKey="HBComboBoxPadding"/>
    <x:Double x:Key="ListViewItemMinHeight">32</x:Double>
</ResourceDictionary>
