<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Design/CompactMetrics.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!-- Preserve WinUI templates, focus visuals, brushes and visual states. -->
    <Style x:Key="HBCompactButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBControlMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBButtonPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource HBCompactButtonStyle}"/>
    <Style x:Key="HBMediaSourceButtonStyle" TargetType="Button" BasedOn="{StaticResource HBCompactButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBMediaSourceMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBCardPadding}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="HBCompactAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBControlMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBButtonPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
    <Style x:Key="HBCompactIconButtonStyle" TargetType="Button" BasedOn="{StaticResource HBCompactButtonStyle}">
        <Setter Property="Width" Value="{StaticResource HBIconButtonSize}"/>
        <Setter Property="Height" Value="{StaticResource HBIconButtonSize}"/>
        <Setter Property="MinWidth" Value="{StaticResource HBIconButtonSize}"/>
        <Setter Property="Padding" Value="{StaticResource HBIconButtonPadding}"/>
    </Style>
    <Style x:Key="HBCompactComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBControlMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBComboBoxPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource HBCompactComboBoxStyle}"/>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBControlMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBMenuItemPadding}"/>
    </Style>
    <Style x:Key="HBCompactDropDownButtonStyle" TargetType="DropDownButton" BasedOn="{StaticResource DefaultDropDownButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBControlMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBButtonPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
    <Style TargetType="DropDownButton" BasedOn="{StaticResource HBCompactDropDownButtonStyle}"/>
    <Style x:Key="HBCompactTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBControlMinHeight}"/>
        <Setter Property="Padding" Value="{StaticResource HBInputPadding}"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource HBCompactTextBoxStyle}"/>
    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBChoiceRowMinHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="MinHeight" Value="{StaticResource HBChoiceRowMinHeight}"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource HBBodyFontSize}"/>
    </Style>
    <Style x:Key="HBCompactCardStyle" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource HBCardPadding}"/>
        <Setter Property="CornerRadius" Value="{StaticResource HBCardCornerRadius}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
    </Style>
    <Style x:Key="HBCompactCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HBCaptionFontSize}"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="HBCompactSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource HBSectionFontSize}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>
