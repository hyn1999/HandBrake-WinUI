<Window
    x:Class="HandBrake.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HandBrake WinUI Preview">
    <Grid>
        <NavigationView
            x:Name="AppNavigation"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.Content>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Padding="32,28,32,36">
                        <StackPanel x:Name="HomePanel" Spacing="18">
                            <TextBlock Text="HandBrake" FontSize="32" FontWeight="SemiBold" />
                            <TextBlock Text="A Windows 11 experience for HandBrake"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Border CornerRadius="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    Padding="24">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Source video" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose a video to get started."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Content="Open video" Click="OpenSource_Click"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource AccentButtonStyle}" />
                                    <TextBlock x:Name="SelectedFileText"
                                               Text="No video selected"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock x:Name="SelectedPathText"
                                               Text=""
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <InfoBar x:Name="SourceInfoBar"
                                     IsOpen="True"
                                     IsClosable="False"
                                     Severity="Informational"
                                     Title="Early preview"
                                     Message="The WinUI 3 shell and file picker are implemented. Source scanning, presets, queue processing, and video encoding are not yet connected." />
                        </StackPanel>

                        <StackPanel x:Name="QueuePanel" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Queue" FontSize="32" FontWeight="SemiBold" />
                            <InfoBar IsOpen="True" IsClosable="False"
                                     Severity="Informational" Title="Coming next"
                                     Message="The existing HandBrake queue service will be connected here in a later milestone." />
                        </StackPanel>

                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" Spacing="16">
                            <TextBlock Text="Settings" FontSize="32" FontWeight="SemiBold" />
                            <InfoBar IsOpen="True" IsClosable="False"
                                     Severity="Informational" Title="Coming next"
                                     Message="Settings and presets will reuse HandBrake's existing application logic where feasible." />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
