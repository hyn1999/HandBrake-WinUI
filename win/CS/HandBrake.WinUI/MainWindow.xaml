<Window
    x:Class="HandBrake.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HandBrake.WinUI"
    Title="HandBrake-WinUI">
    <Grid x:Name="WindowRoot" KeyboardAcceleratorPlacementMode="Hidden" AllowDrop="True" DragOver="WindowRoot_DragOver"
          DragLeave="WindowRoot_DragLeave" Drop="WindowRoot_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Menu" Invoked="OpenSource_AcceleratorInvoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="StartEncode_AcceleratorInvoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="StopEncode_AcceleratorInvoked" />
            <KeyboardAccelerator Key="Q" Modifiers="Control" Invoked="Queue_AcceleratorInvoked" />
            <KeyboardAccelerator Key="A" Modifiers="Menu" Invoked="StageQueue_AcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="HandBrake"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/HandBrake.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="AppNavigation" Grid.Row="1"
                        Loaded="AppNavigation_Loaded"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="240"
                        SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Workspace" Tag="workspace">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Preferences" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid Padding="16,12,16,12">
                    <Grid x:Name="HomePanel" RowSpacing="{StaticResource HBSpaceRow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Source header: commands, source identity, then one bounded selection group. -->
                        <Grid x:Name="SourceHeader" RowSpacing="{StaticResource HBSpaceGroup}" SizeChanged="SourceHeader_SizeChanged">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <StackPanel x:Name="WorkspaceCommands" Spacing="{StaticResource HBMainCommandGap}" HorizontalAlignment="Stretch">
                                <StackPanel.Resources>
                                    <ResourceDictionary Source="ms-appx:///Design/StandardCommands.xaml"/>
                                </StackPanel.Resources>
                                <Button Click="ShowSourcePicker_Click" ToolTipService.ToolTip="Open Source (Alt+O)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBMainCommandIconTextGap}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}"><SymbolIcon Symbol="OpenFile"/></Viewbox>
                                        <TextBlock Text="Open Source" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StageQueueButton" Click="StageQueue_Click" IsEnabled="False"
                                        ToolTipService.ToolTip="Add to Queue (Alt+A)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBMainCommandIconTextGap}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}"><SymbolIcon x:Name="StageQueueIcon" Symbol="Add"/></Viewbox>
                                        <TextBlock x:Name="StageQueueLabel" Text="Add to Queue" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelQueueEditButton" Click="CancelQueueEdit_Click" Visibility="Collapsed" ToolTipService.ToolTip="Cancel edit">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBMainCommandIconTextGap}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}"><SymbolIcon Symbol="Cancel"/></Viewbox>
                                        <TextBlock Text="Cancel edit" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="StartEncodeButton" Click="StartEncode_Click" IsEnabled="False"
                                        Style="{StaticResource HBMainCommandAccentButtonStyle}" ToolTipService.ToolTip="Start Encode (Ctrl+E)">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBMainCommandIconTextGap}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}"><SymbolIcon Symbol="Play"/></Viewbox>
                                        <TextBlock Text="Start Encode" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Spacing="2">
                                <TextBlock x:Name="SelectedFileText" Text="No source selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SelectedPathText" Text="Choose a video to begin"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource HBCaptionFontSize}"
                                           ToolTipService.ToolTip="{Binding Text, ElementName=SelectedPathText}"/>
                            </StackPanel>
                            <ContentControl x:Name="SourceRangeGate" Grid.Row="2" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                <StackPanel x:Name="SourceRangePanel" Spacing="{StaticResource HBSpaceRow}" Visibility="Collapsed">
                                    <ComboBox x:Name="SourceTitlePicker" Header="Title" Visibility="Collapsed"
                                              MinWidth="0" HorizontalAlignment="Left" SelectionChanged="SourceTitlePicker_SelectionChanged"/>
                                </StackPanel>
                            </ContentControl>
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SourceStatusText"
                                           Text=""
                                           FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CancelScanButton" Grid.Column="1"
                                        Visibility="Collapsed" Click="CancelScan_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBSpaceRow}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Cancel"/></Viewbox><TextBlock Text="Cancel scan" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <ProgressBar x:Name="SourceScanProgress"
                                         Visibility="Collapsed" Minimum="0" Maximum="100"
                                         Value="0" Height="4" />
                        </StackPanel>

                        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}"
                              SizeChanged="WorkspaceGrid_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="WorkspaceEditorRow" Height="*"/>
                                <RowDefinition x:Name="WorkspacePreviewRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                                <ColumnDefinition x:Name="PreviewColumn" Width="350" />
                            </Grid.ColumnDefinitions>

                            <!-- Editor: all HandBrake settings are visible as compact categories. -->
                            <Border x:Name="EditorPanel" Grid.Column="0"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid RowSpacing="{StaticResource HBSpaceRow}" Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="{StaticResource HBSpaceRow}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Preset" VerticalAlignment="Center" FontWeight="SemiBold" />
                                        <DropDownButton x:Name="PresetPicker" Grid.Column="1"
                                                        IsEnabled="False" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left"
                                                        AutomationProperties.Name="HandBrake encoding preset">
                                            <TextBlock x:Name="PresetSelectionText" Text="Choose a preset"
                                                       TextTrimming="CharacterEllipsis" />
                                        </DropDownButton>
                                        <Border x:Name="DefaultPresetBadge" Grid.Column="2" Visibility="Collapsed"
                                                ToolTipService.ToolTip="This preset is selected when the app starts."
                                                VerticalAlignment="Center" CornerRadius="4" Padding="8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="Default" FontSize="{StaticResource HBCaptionFontSize}" />
                                        </Border>
                                        <Border x:Name="ModifiedPresetBadge" Grid.Column="3" Visibility="Collapsed"
                                                ToolTipService.ToolTip="Settings differ from this preset. Use Reload selected preset to restore them."
                                                VerticalAlignment="Center" CornerRadius="4" Padding="8,3"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="Modified" FontSize="{StaticResource HBCaptionFontSize}"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <TabView x:Name="EditorTabs" Grid.Row="1" SelectionChanged="EditorTabs_SelectionChanged" IsAddTabButtonVisible="False"
                                             CanDragTabs="False" CanReorderTabs="False"
                                             TabWidthMode="SizeToContent">
                                        <TabViewItem x:Name="SummaryTab" Header="Summary" IsClosable="False">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Source" FontSize="{StaticResource HBSectionFontSize}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ScanSummaryText"
                                                               Text="Scan a source to see actual title, duration and track counts."
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Configured output" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ConfiguredOutputText" Text="Choose a source and preset." TextWrapping="Wrap" />
                                                    <TextBlock x:Name="ResolvedOutputDetailsText" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="PresetStatusText"
                                                               Text="Built-in presets will load from the matching HandBrake engine."
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Selected preset" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PresetDescriptionText"
                                                               Text="No native preset loaded." TextWrapping="Wrap" />
                                                    <TextBlock Text="Output format" FontWeight="SemiBold" />
                                                    <ContentControl x:Name="ContainerEditorGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><StackPanel x:Name="ContainerEditorPanel" Spacing="{StaticResource HBSpaceTight}" /></ContentControl>
                                                    <TextBlock x:Name="PresetContainerText" Text="Not available" />
                                                    <TextBlock Text="Preset rules are resolved by the native engine. Manual audio, subtitle and filter editing supports a subset of HandBrake options."
                                                               TextWrapping="Wrap" FontSize="{StaticResource HBCaptionFontSize}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Dimensions" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Dimensions" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SourceDimensionsText"
                                                               Text="Source dimensions will appear after scanning."
                                                               TextWrapping="Wrap" />
                                                    <CheckBox x:Name="CustomGeometryToggle" Content="Override preset geometry with manual dimensions and cropping" Checked="GeometryOverride_Toggled" Unchecked="GeometryOverride_Toggled" />
                                                    <TextBlock Text="Set image dimensions before borders. Preset rotation, flip and borders are retained; quarter-turn rotation inverts the source pixel aspect ratio. Crop coordinates follow the rotated image. Add to queue or save the edited job to apply changes." TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <NumberBox x:Name="OutputWidthBox" IsEnabled="False" Header="Width (pixels)" Minimum="2" Maximum="16384" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="OutputHeightBox" IsEnabled="False" Grid.Column="1" Header="Height (pixels)" Minimum="2" Maximum="16384" SpinButtonPlacementMode="Inline" />
                                                    </Grid>
                                                    <TextBlock Text="Crop edges (pixels after preset rotation)" FontWeight="SemiBold" />
                                                    <Grid ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <NumberBox x:Name="CropTopBox" IsEnabled="False" Header="Top" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="CropBottomBox" IsEnabled="False" Grid.Column="1" Header="Bottom" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="CropLeftBox" IsEnabled="False" Grid.Row="1" Header="Left" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="CropRightBox" IsEnabled="False" Grid.Row="1" Grid.Column="1" Header="Right" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Filters" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Filters" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="FilterEditorStatus" Text="Filter presets and tunes require the matching native HandBrake engine." TextWrapping="Wrap" />
                                                    <CheckBox x:Name="UsePresetFiltersToggle" Content="Use preset filters" IsChecked="True" Checked="PresetRules_Toggled" Unchecked="PresetRules_Toggled" />
                                                    <ContentControl x:Name="FilterEditorGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><StackPanel x:Name="FilterEditorPanel" Spacing="{StaticResource HBSpaceTight}" /></ContentControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Video" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Video encoding" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SourceVideoText"
                                                               Text="Source codec and frame rate will appear after scanning."
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Video encoder" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="VideoEncoderPicker"
                                                              HorizontalAlignment="Stretch" IsEnabled="False"
                                                              SelectionChanged="VideoEncoderPicker_SelectionChanged" />
                                                    <TextBlock Text="Rate control" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="VideoRateModePicker" IsEnabled="False"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="VideoRateModePicker_SelectionChanged">
                                                        <ComboBoxItem Content="Constant quality" />
                                                        <ComboBoxItem Content="Average bitrate" />
                                                    </ComboBox>
                                                    <StackPanel x:Name="QualityControlPanel" Spacing="6">
                                                        <TextBlock x:Name="VideoQualityText"
                                                                   Text="Quality: not configured" />
                                                        <Slider x:Name="VideoQualitySlider"
                                                                Minimum="0" Maximum="51" Value="22"
                                                                IsEnabled="False"
                                                                ValueChanged="VideoQualitySlider_ValueChanged" />
                                                    </StackPanel>
                                                    <NumberBox x:Name="VideoBitrateBox"
                                                               Header="Average bitrate (kbps)"
                                                               Minimum="100" Maximum="200000"
                                                               Value="2500" SpinButtonPlacementMode="Inline"
                                                               Visibility="Collapsed" IsEnabled="False"
                                                               ValueChanged="VideoBitrateBox_ValueChanged" />
                                                    <ContentControl x:Name="AdvancedVideoGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><StackPanel x:Name="AdvancedVideoPanel" Spacing="{StaticResource HBSpaceTight}" /></ContentControl>
                                                    <TextBlock Text="Preset reference"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PresetVideoDetailsText"
                                                               Text="Not available" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="VideoConfigurationStatusText"
                                                               Text="Select a native preset and encoder to configure a queue draft."
                                                               FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Changing the encoder or rate control updates a draft configuration only. It does not start encoding or modify HandBrake's built-in preset."
                                                               FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Audio" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Audio tracks" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <CheckBox x:Name="UsePresetAudioToggle" Content="Use preset audio selection and encoding rules" IsChecked="True" Checked="PresetRules_Toggled" Unchecked="PresetRules_Toggled" />
                                                    <ContentControl x:Name="AudioEditorGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><StackPanel x:Name="AudioTrackList" Spacing="{StaticResource HBSpaceRow}">
                                                        <TextBlock Text="Tracks will appear after scanning a source."
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel></ContentControl>
                                                    <TextBlock Text="Checked tracks are included in newly staged jobs, one output per source track. Uncheck all tracks for silent output. Choose a per-track encoder and bitrate, or retain the preset audio rule. Custom encoding uses the native default mixdown and source-compatible sample rate. Passthrough, lossless and multiple outputs per track still require full rule editing." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Subtitles" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Subtitles" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <CheckBox x:Name="UsePresetSubtitlesToggle" Content="Use preset subtitle selection and search rules" IsChecked="True" Checked="PresetRules_Toggled" Unchecked="PresetRules_Toggled" />
                                                    <ContentControl x:Name="SubtitleEditorGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><StackPanel x:Name="SubtitleManualPanel" Spacing="{StaticResource HBSpaceRow}">
                                                    <CheckBox x:Name="ForeignAudioSearchToggle" Content="Foreign Audio Search" Checked="ForeignSearch_Toggled" Unchecked="ForeignSearch_Toggled" />
                                                    <CheckBox x:Name="ForeignAudioForcedToggle" IsEnabled="False" Content="Search forced subtitles only" IsChecked="True" />
                                                    <CheckBox x:Name="ForeignAudioBurnToggle" IsEnabled="False" Content="Burn the search result into video" />
                                                    <TextBlock Text="Search runs during encoding. A still preview cannot show its result. Burn-in shares the single-track limit with other subtitles." TextWrapping="Wrap" />
                                                    <StackPanel x:Name="SubtitleTrackList" Spacing="{StaticResource HBSpaceRow}">
                                                        <TextBlock Text="Subtitle tracks will appear after scanning."
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Content="Import SRT files" Click="ImportSubtitle_Click" HorizontalAlignment="Left" />
                                                    <TextBlock x:Name="SubtitleImportStatus" Text="UTF-8 SRT soft subtitles support MP4 and MKV. At most one internal or imported track may be burned into video." TextWrapping="Wrap" />
                                                    <StackPanel x:Name="ImportedSubtitleList" Spacing="{StaticResource HBSpaceTight}" />
                                                    <TextBlock Text="Select internal subtitle tracks to include. Soft subtitles require a compatible container. Burn-in is permanent in the output image and cannot be switched off during playback. Foreign-audio search runs during encoding. Re-stage the queue entry after editing." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel></ContentControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Chapters" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Chapters" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <CheckBox x:Name="ChapterMarkersToggle" Content="Create chapter markers" IsChecked="True" />
                                                    <StackPanel x:Name="ChapterEditorPanel" Spacing="{StaticResource HBSpaceTight}" />
                                                    <TextBlock x:Name="ChapterListText"
                                                               Text="Chapter titles will appear here after source scanning."
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Metadata" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock Text="Metadata" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" />
                                                    <TextBlock Text="Overrides apply to newly staged jobs. Leave a field empty to retain source metadata." TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceRow}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <TextBox x:Name="MetadataTitleBox" Header="Title" />
                                                        <TextBox x:Name="MetadataArtistBox" Header="Artist" Grid.Column="1" />
                                                        <TextBox x:Name="MetadataAlbumBox" Header="Album" Grid.Row="1" />
                                                    </Grid>
                                                    <TextBox x:Name="MetadataCommentBox" Header="Comment" AcceptsReturn="True" TextWrapping="Wrap" />
                                                    <TextBlock Text="Metadata overrides are saved with each queued job."
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                    </TabView>
                                </Grid>
                            </Border>

                            <!-- Bounded image viewport; navigation and source details remain outside it. -->
                            <Border x:Name="PreviewPanel" Grid.Column="1"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid Padding="12" RowSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="{StaticResource HBSpaceRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Preview" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="OpenPreviewWindowButton" Grid.Column="1" Click="OpenPreviewWindow_Click"
                                                IsEnabled="False" Style="{StaticResource HBCompactIconButtonStyle}"
                                                AutomationProperties.Name="Expand preview"
                                                ToolTipService.ToolTip="Open a larger preview window">
                                            <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="FullScreen"/></Viewbox>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="1" RowSpacing="{StaticResource HBSpaceRow}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8" MinHeight="0" VerticalAlignment="Stretch">
                                            <Grid x:Name="PreviewViewport" MinWidth="0" MinHeight="0"
                                                  SizeChanged="PreviewViewport_SizeChanged">
                                                <Image x:Name="PreviewFrame" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                                <StackPanel x:Name="PreviewPlaceholder"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="{StaticResource HBSpaceRow}" Margin="16">
                                                    <SymbolIcon Symbol="Pictures" />
                                                    <TextBlock x:Name="PreviewPlaceholderText"
                                                               Text="Choose a source to decode a real frame"
                                                               TextWrapping="Wrap" TextAlignment="Center" />
                                                    <TextBlock Text="Decoded by the native HandBrake engine"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" ColumnSpacing="{StaticResource HBSpaceRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PreviousPreviewButton" IsEnabled="False" Click="PreviousPreview_Click"
                                                    Style="{StaticResource HBCompactIconButtonStyle}"
                                                    AutomationProperties.Name="Previous preview frame" ToolTipService.ToolTip="Previous frame">
                                                <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Back"/></Viewbox>
                                            </Button>
                                            <TextBlock x:Name="PreviewFrameCounterText" Grid.Column="1"
                                                       Text="No frame" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="NextPreviewButton" Grid.Column="2" IsEnabled="False" Click="NextPreview_Click"
                                                    Style="{StaticResource HBCompactIconButtonStyle}"
                                                    AutomationProperties.Name="Next preview frame" ToolTipService.ToolTip="Next frame">
                                                <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Forward"/></Viewbox>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <ScrollViewer Grid.Row="2" MaxHeight="100" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                        <TextBlock Text="Source details" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PreviewSourceText" Text="No source selected"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PreviewMetadataText"
                                                   Text="Scan a video to display its properties."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Destination stays editable; encode commands have one home in the toolbar. -->
                        <Border Grid.Row="3" CornerRadius="10" Padding="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Destination" FontSize="{StaticResource HBCaptionFontSize}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox PlaceholderText="Choose a source to prepare an output filename" MaxWidth="10000" HorizontalAlignment="Stretch" x:Name="DestinationText" TextChanged="Destination_Changed" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="BrowseDestination_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Choose the output folder">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBSpaceRow}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Folder"/></Viewbox><TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="QueuePanel" Visibility="Collapsed" RowSpacing="{StaticResource HBSpaceRow}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="{StaticResource HBSpaceTight}">
                            <TextBlock Text="Queue" FontSize="{StaticResource HBPageTitleFontSize}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="QueueCountText" Text="No jobs" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
                            <CommandBar.Resources>
                                <ResourceDictionary Source="ms-appx:///Design/StandardCommands.xaml"/>
                            </CommandBar.Resources>
                            <AppBarButton x:Name="StartQueueEncodeButton" Label="Start queue" Click="StartEncode_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Play"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="PauseQueueButton" Label="Pause" Click="PauseQueue_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Pause"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="CancelEncodeButton" Label="Stop" Click="CancelEncode_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Stop"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator/>
                            <AppBarButton x:Name="ClearDraftsButton" Label="Clear queue" Click="ClearDrafts_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Delete"/></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <Grid x:Name="QueueBody" Grid.Row="2" ColumnSpacing="{StaticResource HBSpaceGroup}" SizeChanged="QueueBody_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="QueueListColumn" Width="0.65*"/><ColumnDefinition x:Name="QueueDetailColumn" Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition x:Name="QueueListRow" Height="*"/><RowDefinition x:Name="QueueDetailRow" Height="0"/></Grid.RowDefinitions>
                            <Border CornerRadius="10" BorderThickness="1" Padding="4"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <ListView x:Name="DraftQueueList" SelectionMode="Single" SelectionChanged="DraftQueueList_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" Padding="6,8" ToolTipService.ToolTip="{Binding DestinationPath}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="{Binding StateIcon}" VerticalAlignment="Center"/></Viewbox>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RowSummary}" FontSize="{StaticResource HBCaptionFontSize}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                            <Border x:Name="QueueDetailsCard" Grid.Column="1" CornerRadius="10" Padding="12" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid RowSpacing="{StaticResource HBSpaceRow}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock x:Name="QueueSelectedTitle" Text="Select a job" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
                            <CommandBar.Resources>
                                <ResourceDictionary Source="ms-appx:///Design/StandardCommands.xaml"/>
                            </CommandBar.Resources>
                                        <AppBarButton x:Name="EditQueueJobButton" Label="Edit" Click="EditQueueJob_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Edit"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="ResetQueueJobButton" Label="Reset / Retry" Click="ResetQueueJob_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Refresh"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MoveQueueUpButton" Label="Move up" Click="MoveQueueUp_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Up"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MoveQueueDownButton" Label="Move down" Click="MoveQueueDown_Click" IsEnabled="False">
                                            <AppBarButton.Icon><FontIcon Glyph="&#xE74B;"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="RemoveDraftButton" Label="Remove" Click="RemoveDraft_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Delete"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton x:Name="OpenQueueSourceButton" Label="Open source in Workspace" Click="OpenQueueSource_Click" IsEnabled="False"/>
                                            <AppBarButton x:Name="OpenQueueOutputButton" Label="Open output folder" Click="OpenQueueOutput_Click" IsEnabled="False"/>
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                    <TabView x:Name="QueueDetailTabs" Grid.Row="2" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                                             TabWidthMode="SizeToContent" SelectionChanged="QueueDetailTabs_SelectionChanged">
                                        <TabViewItem Header="Summary" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Spacing="{StaticResource HBSpaceGroup}" Padding="4,12">
                                                    <InfoBar x:Name="QueueJobError" IsOpen="False" IsClosable="False" Severity="Error" Title="Job needs attention"/>
                                                    <StackPanel x:Name="QueueSummaryFields" Spacing="{StaticResource HBSpaceRow}"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Statistics" IsClosable="False">
                                            <ScrollViewer>
                                            <StackPanel Spacing="{StaticResource HBSpaceGroup}" Padding="4,12">
                                                <ProgressBar x:Name="QueueJobProgress" Minimum="0" Maximum="100"/>
                                                <TextBlock x:Name="QueueJobStatsText" Text="No statistics available." TextWrapping="Wrap"/>
                                            </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Activity Log" IsClosable="False">
                                            <Grid RowSpacing="{StaticResource HBSpaceRow}" Padding="4,8">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Button Content="Refresh log" Click="RefreshQueueLog_Click"/>
                                                <TextBox x:Name="QueueJobLogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                         MaxWidth="100000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                         FontFamily="Consolas" FontSize="{StaticResource HBCaptionFontSize}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                            </Grid>
                                        </TabViewItem>
                                    </TabView>
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="3" Spacing="{StaticResource HBSpaceTight}">
                            <InfoBar x:Name="QueueStorageWarning" IsOpen="False" IsClosable="False" Severity="Warning"
                                     Title="Queue storage is unavailable"/>
                            <TextBlock x:Name="QueueStatusText" FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap" Text="Add a configured source to begin."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="QueueEncodeProgress" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <local:PreferencesView x:Name="SettingsPanel" Visibility="Collapsed" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <!-- Fluent source dialog: source selection stays in the Workspace context. -->
        <Grid x:Name="SourcePickerOverlay" Grid.Row="1" Visibility="Collapsed"
              Background="#77000000" Opacity="1">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="12" />
                </TransitionCollection>
            </Grid.Transitions>
            <Border MaxWidth="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel Padding="24" Spacing="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                <TextBlock Text="Add media" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Drop media below or browse for a source." FontSize="13"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Close" Click="CloseSourcePicker_Click"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Close Add media" />
                        </Grid>
                        <Border MinHeight="240" Padding="24" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Border x:Name="SourceDropFeedback" Visibility="Collapsed" IsHitTestVisible="False"
                                        Margin="-24" CornerRadius="8" BorderThickness="2"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.08" CornerRadius="6"/>
                                </Border>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource HBSpaceRow}">
                                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="OpenFile" HorizontalAlignment="Center"/></Viewbox>
                                    <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                        <TextBlock Text="Drop files or folders" FontSize="18" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="HandBrake scans your media to detect video titles." FontSize="13"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid x:Name="SourceBrowseActions" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}"
                              SizeChanged="SourceBrowseActions_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition x:Name="SourceBrowseSecondColumn" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition x:Name="SourceBrowseSecondRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Button Click="OpenFiles_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource HBMediaSourceButtonStyle}">
                                <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="{StaticResource HBMediaSourceIconSize}" Height="{StaticResource HBMediaSourceIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="OpenFile" VerticalAlignment="Center" /></Viewbox>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Browse files" FontSize="{StaticResource HBBodyFontSize}" FontWeight="SemiBold" />
                                        <TextBlock Text="Select one or more videos" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="SourceBrowseFolderButton" Grid.Column="1" Click="OpenFolder_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource HBMediaSourceButtonStyle}">
                                <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="{StaticResource HBMediaSourceIconSize}" Height="{StaticResource HBMediaSourceIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Folder" VerticalAlignment="Center" /></Viewbox>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Browse folder" FontSize="{StaticResource HBBodyFontSize}" FontWeight="SemiBold" />
                                        <TextBlock Text="Scan a media folder" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Hit-test transparent feedback while dragging from File Explorer. -->
        <Border x:Name="DropHighlight" Grid.Row="1" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="12" CornerRadius="12"
                BorderThickness="3" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="#330080C0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="{StaticResource HBSpaceGroup}" Margin="16">
                <SymbolIcon Symbol="OpenFile" />
                <TextBlock Text="Drop to open source"
                           FontSize="22" FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="Files and folders are supported"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
