<Window
    x:Class="HandBrake.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:copy="using:HandBrake.WinUI.Resources"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HandBrake.WinUI"
    Title="HandBrake-WinUI">
    <Grid x:Name="WindowRoot" KeyboardAcceleratorPlacementMode="Hidden" AllowDrop="True" DragOver="WindowRoot_DragOver"
          DragLeave="WindowRoot_DragLeave" Drop="WindowRoot_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Menu" Invoked="OpenSource_AcceleratorInvoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="StartEncode_AcceleratorInvoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="StopEncode_AcceleratorInvoked" />
            <KeyboardAccelerator Key="Q" Modifiers="Control" Invoked="Queue_AcceleratorInvoked" />
            <KeyboardAccelerator Key="A" Modifiers="Menu" Invoked="StageQueue_AcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="HandBrake"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/HandBrake.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="AppNavigation" Grid.Row="1"
                        Loaded="AppNavigation_Loaded"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="240"
                        SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Workspace" Tag="workspace">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.InfoBadge><InfoBadge x:Name="NavigationQueueBadge" Visibility="Collapsed" /></NavigationViewItem.InfoBadge>
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Preferences" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid Padding="16,12,16,12">
                    <Grid x:Name="HomePanel" RowSpacing="{StaticResource HBSpaceRow}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="SourceHeader" Spacing="{StaticResource HBSpaceGroup}" SizeChanged="SourceHeader_SizeChanged">
                            <CommandBar x:Name="WorkspaceCommands" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent" IsDynamicOverflowEnabled="True">
                                <CommandBar.Resources><ResourceDictionary Source="ms-appx:///Design/StandardCommands.xaml"/></CommandBar.Resources>
                                <AppBarButton Icon="OpenFile" Label="Open Source" Click="ShowSourcePicker_Click" ToolTipService.ToolTip="Open Source (Alt+O)" />
                                <AppBarButton x:Name="StageQueueButton" Label="Add to Queue" Click="StageQueue_Click" IsEnabled="False" ToolTipService.ToolTip="Add to Queue (Alt+A)">
                                    <AppBarButton.Icon><SymbolIcon x:Name="StageQueueIcon" Symbol="Add"/></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton x:Name="CancelQueueEditButton" Icon="Cancel" Label="Cancel edit" Click="CancelQueueEdit_Click" Visibility="Collapsed" />
                                <AppBarButton x:Name="StartEncodeButton" Icon="Play" Label="Start Encode" Click="StartEncode_Click" IsEnabled="False" ToolTipService.ToolTip="Start Encode (Ctrl+E)" />
                                <AppBarElementContainer x:Name="QueueBadgeContainer" Visibility="Collapsed">
                                    <InfoBadge x:Name="ReadyQueueBadge" VerticalAlignment="Center" />
                                </AppBarElementContainer>
                            </CommandBar>
                            <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedFileText" Text="No source selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                    <TextBlock.ContextFlyout><MenuFlyout>
                                        <MenuFlyoutItem x:Name="CopySourcePathItem" Text="Copy path" Click="CopySourcePath_Click" IsEnabled="False" />
                                        <MenuFlyoutItem x:Name="OpenSourceFolderItem" Text="Open source folder" Click="OpenSourceFolder_Click" IsEnabled="False" />
                                    </MenuFlyout></TextBlock.ContextFlyout>
                                </TextBlock>
                                <TextBlock x:Name="SourceFactsText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </Grid>
                            <ContentControl x:Name="SourceRangeGate" IsEnabled="False" Visibility="Collapsed" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                <StackPanel x:Name="SourceRangePanel" Spacing="{StaticResource HBSpaceRow}">
                                    <ComboBox x:Name="SourceTitlePicker" Header="Title" Visibility="Collapsed" MinWidth="0" HorizontalAlignment="Left" SelectionChanged="SourceTitlePicker_SelectionChanged" />
                                </StackPanel>
                            </ContentControl>
                            <StackPanel x:Name="SourceActivityPanel" Visibility="Collapsed" Spacing="{StaticResource HBSpaceTight}">
                                <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="SourceStatusText" FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button x:Name="CancelScanButton" Grid.Column="1" Content="Cancel scan" Visibility="Collapsed" Click="CancelScan_Click" />
                                </Grid>
                                <ProgressBar x:Name="SourceScanProgress" Visibility="Collapsed" Minimum="0" Maximum="100" Value="0" Height="4" />
                            </StackPanel>
                        </StackPanel>

                        <Grid x:Name="WorkspaceGrid" Grid.Row="1" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}"
                              SizeChanged="WorkspaceGrid_SizeChanged">
                            <Grid.Transitions><TransitionCollection><RepositionThemeTransition /></TransitionCollection></Grid.Transitions>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="WorkspaceEditorRow" Height="*"/>
                                <RowDefinition x:Name="WorkspacePreviewRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                                <ColumnDefinition x:Name="PreviewColumn" Width="350" />
                            </Grid.ColumnDefinitions>

                            <!-- Editor: all HandBrake settings are visible as compact categories. -->
                            <Border x:Name="EditorPanel" Grid.Column="0"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid RowSpacing="{StaticResource HBSpaceRow}" Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid x:Name="PresetSelectorRow" ColumnSpacing="{StaticResource HBControlGap}" SizeChanged="PresetSelectorRow_SizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Preset" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="PresetPicker" Grid.Column="1" IsEnabled="False"
                                                  PlaceholderText="Choose a preset" HorizontalAlignment="Left" MinWidth="0"
                                                  Width="{StaticResource HBPresetWidth}" MaxWidth="{StaticResource HBPresetMaxWidth}"
                                                  SelectionChanged="PresetPicker_SelectionChanged" DropDownOpened="PresetPicker_DropDownOpened"
                                                  AutomationProperties.Name="HandBrake encoding preset"/>
                                        <Button x:Name="ReloadPresetButton" Grid.Column="2" IsEnabled="False"
                                                Content="Reload" Click="ReloadPreset_Click" ToolTipService.ToolTip="Reload selected preset"/>
                                        <Button x:Name="PresetActionsButton" Grid.Column="3" IsEnabled="False"
                                                Style="{StaticResource HBCompactIconButtonStyle}"
                                                AutomationProperties.Name="Preset actions" ToolTipService.ToolTip="Preset actions">
                                            <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}"><SymbolIcon Symbol="More"/></Viewbox>
                                        </Button>
                                    </Grid>

                                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" IsTabStop="False">
                                        <SelectorBar x:Name="EditorTabs" SelectionChanged="EditorTabs_SelectionChanged">
                                            <SelectorBarItem x:Name="SummaryTab" Text="{x:Bind copy:WpfText.SummarySection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="DimensionsTab" Text="{x:Bind copy:WpfText.DimensionsSection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="FiltersTab" Text="{x:Bind copy:WpfText.FiltersSection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="VideoTab" Text="{x:Bind copy:WpfText.VideoSection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="AudioTab" Text="{x:Bind copy:WpfText.AudioSection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="SubtitlesTab" Text="{x:Bind copy:WpfText.SubtitlesSection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="ChaptersTab" Text="{x:Bind copy:WpfText.ChaptersSection, Mode=OneTime}" />
                                            <SelectorBarItem x:Name="MetadataTab" Text="{x:Bind copy:WpfText.MetadataSection, Mode=OneTime}" />
                                        </SelectorBar>
                                    </ScrollViewer>
                                    <Grid x:Name="EditorPages" Grid.Row="2">
<ScrollViewer x:Name="SummaryPage" Visibility="Visible" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <Grid Padding="{StaticResource HBCardPadding}" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                    <TextBlock x:Name="FormatSummaryLabel" Text="{x:Bind copy:WpfText.Format, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="{StaticResource HBBodyFontSize}" VerticalAlignment="Top" />
                                                    <ContentControl x:Name="ContainerEditorGate" Grid.Column="1" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                                        <StackPanel x:Name="ContainerEditorPanel" Spacing="{StaticResource HBSpaceTight}" />
                                                    </ContentControl>
                                                    <TextBlock Text="{x:Bind copy:WpfText.Tracks, Mode=OneTime}" Grid.Row="1" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="{StaticResource HBBodyFontSize}" />
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="{StaticResource HBSpaceTight}">
                                                        <TextBlock x:Name="ConfiguredOutputText" Text="—" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="ResolvedOutputDetailsText" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Text="{x:Bind copy:WpfText.Filters, Mode=OneTime}" Grid.Row="2" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="{StaticResource HBBodyFontSize}" />
                                                    <TextBlock x:Name="FilterSummaryText" Grid.Row="2" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind copy:WpfText.Size, Mode=OneTime}" Grid.Row="3" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="{StaticResource HBBodyFontSize}" />
                                                    <TextBlock x:Name="SizeSummaryText" Grid.Row="3" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="SummaryStatusText" Grid.Row="4" Grid.ColumnSpan="2" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </ScrollViewer>
<ScrollViewer x:Name="DimensionsPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="{StaticResource HBCardPadding}" Spacing="{StaticResource HBSpaceGroup}">
                                                    <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                                        <TextBlock Text="{x:Bind copy:WpfText.SourceDimensions, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                        <TextBlock x:Name="SourceDimensionsText" Text="—" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <CheckBox x:Name="CustomGeometryToggle" Content="Custom dimensions and cropping" Checked="GeometryOverride_Toggled" Unchecked="GeometryOverride_Toggled" />
                                                    <Grid x:Name="DimensionsGroups" SizeChanged="DimensionsGroups_SizeChanged" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel Spacing="{StaticResource HBSpaceRow}" VerticalAlignment="Top">
                                                            <TextBlock Text="{x:Bind copy:WpfText.OrientationAndCropping, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                            <TextBlock x:Name="OrientationSummaryText" Text="—" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="CroppingModeText" Text="Cropping: From preset" TextWrapping="Wrap" />
                                                            <Grid ColumnSpacing="{StaticResource HBSpaceTight}" RowSpacing="{StaticResource HBSpaceTight}">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                                <NumberBox x:Name="CropTopBox" Grid.Column="1" Header="{x:Bind copy:WpfText.Top, Mode=OneTime}" IsEnabled="False" Minimum="0" Maximum="16384" Value="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                                                <NumberBox x:Name="CropLeftBox" Grid.Row="1" Header="{x:Bind copy:WpfText.Left, Mode=OneTime}" IsEnabled="False" Minimum="0" Maximum="16384" Value="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                                                <NumberBox x:Name="CropRightBox" Grid.Row="1" Grid.Column="2" Header="{x:Bind copy:WpfText.Right, Mode=OneTime}" IsEnabled="False" Minimum="0" Maximum="16384" Value="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                                                <NumberBox x:Name="CropBottomBox" Grid.Row="2" Grid.Column="1" Header="{x:Bind copy:WpfText.Bottom, Mode=OneTime}" IsEnabled="False" Minimum="0" Maximum="16384" Value="0" SpinButtonPlacementMode="Inline" HorizontalAlignment="Stretch" />
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Spacing="{StaticResource HBSpaceRow}" VerticalAlignment="Top">
                                                            <TextBlock Text="{x:Bind copy:WpfText.ResolutionAndScaling, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                            <TextBlock x:Name="ScalingSummaryText" Text="—" TextWrapping="Wrap" />
                                                            <TextBlock x:Name="PixelAspectSummaryText" Text="—" TextWrapping="Wrap" />
                                                            <ContentControl x:Name="DimensionsSizeFields" IsTabStop="False" HorizontalContentAlignment="Stretch" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Spacing="{StaticResource HBSpaceRow}" VerticalAlignment="Top">
                                                            <TextBlock Text="{x:Bind copy:WpfText.Borders, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                            <TextBlock x:Name="BordersSummaryText" Text="—" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                                        <TextBlock Text="{x:Bind copy:WpfText.FinalDimensions, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                        <TextBlock x:Name="FinalDimensionsText" Text="—" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="DimensionsStatusText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
<ScrollViewer x:Name="FiltersPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="{StaticResource HBCardPadding}" Spacing="{StaticResource HBSpaceRow}">
                                                    <TextBlock x:Name="FilterEditorStatus" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <ContentControl x:Name="FilterControlsGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><Grid x:Name="FilterEditorPanel" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceRow}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    </Grid></ContentControl>
                                                </StackPanel>
                                            </ScrollViewer>
<ScrollViewer x:Name="VideoPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="{StaticResource HBCardPadding}" Spacing="{StaticResource HBSpaceGroup}">
                                                    <Grid x:Name="VideoMainGroups" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}" SizeChanged="VideoMainGroups_SizeChanged">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel Spacing="{StaticResource HBSpaceRow}">
                                                            <TextBlock Text="{x:Bind copy:WpfText.Video, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                            <ContentControl x:Name="VideoBasicsGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch"><Grid x:Name="VideoBasicsPanel" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceRow}">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            </Grid></ContentControl>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Spacing="{StaticResource HBSpaceRow}">
                                                            <TextBlock Text="{x:Bind copy:WpfText.VideoQuality, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                            <StackPanel x:Name="QualityControlPanel" Spacing="{StaticResource HBSpaceTight}">
                                                                <Grid ColumnSpacing="{StaticResource HBSpaceRow}">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                    <RadioButton x:Name="ConstantQualityChoice" GroupName="VideoRateControl" Content="{x:Bind copy:WpfText.ConstantQuality, Mode=OneTime}" IsEnabled="False" Checked="VideoRateControl_Checked" />
                                                                    <TextBlock x:Name="VideoQualityText" Grid.Column="1" Text="—" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                                </Grid>
                                                                <Slider x:Name="VideoQualitySlider" Minimum="0" Maximum="51" Value="22" IsEnabled="False" ValueChanged="VideoQualitySlider_ValueChanged" />
                                                                <Grid x:Name="QualityScaleLabels">
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{x:Bind copy:WpfText.LowerQuality, Mode=OneTime}" TextWrapping="Wrap" FontSize="{StaticResource HBCaptionFontSize}" />
                                                                    <TextBlock x:Name="VideoHighQualityText" Grid.Column="1" HorizontalAlignment="Right" TextWrapping="Wrap" FontSize="{StaticResource HBCaptionFontSize}" />
                                                                </Grid>
                                                            </StackPanel>
                                                            <ContentControl x:Name="VideoBitrateRow" IsTabStop="False" HorizontalContentAlignment="Stretch" />
                                                            <StackPanel x:Name="VideoPassOptions" Spacing="{StaticResource HBSpaceTight}" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <TextBlock Text="{x:Bind copy:WpfText.VideoEncoderOptions, Mode=OneTime}" Style="{StaticResource HBCompactSectionTitleStyle}" />
                                                    <ContentControl x:Name="AdvancedVideoGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                                        <Grid x:Name="AdvancedVideoPanel" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceRow}">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        </Grid>
                                                    </ContentControl>
                                                    <TextBlock x:Name="VideoConfigurationStatusText" Visibility="Collapsed" FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
<ScrollViewer x:Name="AudioPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="{StaticResource HBCardPadding}" Spacing="{StaticResource HBSpaceRow}">
                                                    <CheckBox x:Name="UsePresetAudioToggle" Content="Use preset audio rules" IsChecked="True" Checked="PresetRules_Toggled" Unchecked="PresetRules_Toggled" />
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBControlGap}">
                                                        <Button Content="{x:Bind copy:WpfText.Reload, Mode=OneTime}" Click="ReloadAudio_Click" />
                                                        <Button Content="{x:Bind copy:WpfText.Clear, Mode=OneTime}" Click="ClearAudio_Click" />
                                                    </StackPanel>
                                                    <ContentControl x:Name="AudioEditorGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                                        <StackPanel x:Name="AudioTrackList" Spacing="{StaticResource HBSpaceRow}" />
                                                    </ContentControl>
                                                </StackPanel>
                                            </ScrollViewer>
<ScrollViewer x:Name="SubtitlesPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="{StaticResource HBCardPadding}" Spacing="{StaticResource HBSpaceRow}">
                                                    <CheckBox x:Name="UsePresetSubtitlesToggle" Content="Use preset subtitle rules" IsChecked="True" Checked="PresetRules_Toggled" Unchecked="PresetRules_Toggled" />
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBControlGap}">
                                                        <Button Content="{x:Bind copy:WpfText.Reload, Mode=OneTime}" Click="ReloadSubtitles_Click" />
                                                        <Button Content="{x:Bind copy:WpfText.Clear, Mode=OneTime}" Click="ClearSubtitles_Click" />
                                                    </StackPanel>
                                                    <ContentControl x:Name="SubtitleEditorGate" IsEnabled="False" IsTabStop="False" HorizontalContentAlignment="Stretch">
                                                        <StackPanel x:Name="SubtitleManualPanel" Spacing="{StaticResource HBSpaceRow}">
                                                            <ContentControl x:Name="ForeignSearchFields" IsTabStop="False" HorizontalContentAlignment="Stretch" />
                                                            <StackPanel x:Name="SubtitleTrackList" Spacing="{StaticResource HBSpaceRow}" />
                                                            <Button Content="{x:Bind copy:WpfText.ImportSubtitle, Mode=OneTime}" Click="ImportSubtitle_Click" HorizontalAlignment="Left" />
                                                            <TextBlock x:Name="SubtitleImportStatus" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                            <StackPanel x:Name="ImportedSubtitleList" Spacing="{StaticResource HBSpaceRow}" />
                                                        </StackPanel>
                                                    </ContentControl>
                                                </StackPanel>
                                            </ScrollViewer>
<ScrollViewer x:Name="ChaptersPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="{StaticResource HBCardPadding}" Spacing="{StaticResource HBSpaceRow}">
                                                    <CheckBox x:Name="ChapterMarkersToggle" Content="{x:Bind copy:WpfText.CreateChapters, Mode=OneTime}" IsChecked="True" />
                                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBControlGap}">
                                                        <Button x:Name="ImportChaptersButton" Content="{x:Bind copy:WpfText.ImportChapters, Mode=OneTime}" Click="ImportChapters_Click" IsEnabled="False" />
                                                        <Button x:Name="ExportChaptersButton" Content="{x:Bind copy:WpfText.ExportChapters, Mode=OneTime}" Click="ExportChapters_Click" IsEnabled="False" />
                                                        <Button x:Name="ResetChaptersButton" Content="{x:Bind copy:WpfText.ResetChapters, Mode=OneTime}" Click="ResetChapters_Click" IsEnabled="False" />
                                                    </StackPanel>
                                                    <Grid x:Name="ChapterEditorPanel" ColumnSpacing="{StaticResource HBControlGap}" RowSpacing="{StaticResource HBSpaceRow}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                    </Grid>
                                                    <TextBlock x:Name="ChapterListText" Text="—" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
<ScrollViewer x:Name="MetadataPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                                <Grid x:Name="MetadataFields" Padding="{StaticResource HBCardPadding}" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceRow}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                </Grid>
                                            </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Bounded image viewport; navigation and source details remain outside it. -->
                            <Border x:Name="PreviewPanel" Grid.Column="1"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid Padding="12" RowSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="{StaticResource HBSpaceRow}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="Preview" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <Button x:Name="OpenPreviewWindowButton" Grid.Column="1" Click="OpenPreviewWindow_Click"
                                                IsEnabled="False" Style="{StaticResource HBCompactIconButtonStyle}"
                                                AutomationProperties.Name="Expand preview"
                                                ToolTipService.ToolTip="Open a larger preview window">
                                            <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="FullScreen"/></Viewbox>
                                        </Button>
                                    </Grid>
                                    <Grid Grid.Row="1" RowSpacing="{StaticResource HBSpaceRow}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8" MinHeight="0" VerticalAlignment="Stretch">
                                            <Grid x:Name="PreviewViewport" MinWidth="0" MinHeight="0"
                                                  SizeChanged="PreviewViewport_SizeChanged">
                                                <Image x:Name="PreviewFrame" Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="Collapsed" />
                                                <StackPanel x:Name="PreviewPlaceholder"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="{StaticResource HBSpaceRow}" Margin="16">
                                                    <SymbolIcon Symbol="Pictures" />
                                                    <TextBlock x:Name="PreviewPlaceholderText"
                                                               Text="No preview"
                                                               TextWrapping="Wrap" TextAlignment="Center" />

                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" ColumnSpacing="{StaticResource HBSpaceRow}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PreviousPreviewButton" IsEnabled="False" Click="PreviousPreview_Click"
                                                    Style="{StaticResource HBCompactIconButtonStyle}"
                                                    AutomationProperties.Name="Previous preview frame" ToolTipService.ToolTip="Previous frame">
                                                <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Back"/></Viewbox>
                                            </Button>
                                            <TextBlock x:Name="PreviewFrameCounterText" Grid.Column="1"
                                                       Text="No frame" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="NextPreviewButton" Grid.Column="2" IsEnabled="False" Click="NextPreview_Click"
                                                    Style="{StaticResource HBCompactIconButtonStyle}"
                                                    AutomationProperties.Name="Next preview frame" ToolTipService.ToolTip="Next frame">
                                                <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Forward"/></Viewbox>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Destination stays editable; encode commands have one home in the toolbar. -->
                        <Border Grid.Row="2" CornerRadius="10" Padding="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Destination" FontSize="{StaticResource HBCaptionFontSize}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBox PlaceholderText="Choose a source to prepare an output filename" MaxWidth="10000" HorizontalAlignment="Stretch" x:Name="DestinationText" TextChanged="Destination_Changed" />
                                </StackPanel>
                                <Button Grid.Column="1" Click="BrowseDestination_Click" VerticalAlignment="Center" ToolTipService.ToolTip="Choose the output folder">
                                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource HBSpaceRow}">
                                        <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Folder"/></Viewbox><TextBlock Text="Browse…" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="QueuePanel" Visibility="Collapsed" RowSpacing="{StaticResource HBSpaceRow}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel Spacing="{StaticResource HBSpaceTight}">
                            <TextBlock Text="Queue" FontSize="{StaticResource HBPageTitleFontSize}" FontWeight="SemiBold"/>
                            <TextBlock x:Name="QueueCountText" Text="No jobs" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                        <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
                            <CommandBar.Resources>
                                <ResourceDictionary Source="ms-appx:///Design/StandardCommands.xaml"/>
                            </CommandBar.Resources>
                            <AppBarButton x:Name="StartQueueEncodeButton" Label="Start queue" Click="StartEncode_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Play"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="PauseQueueButton" Label="Pause" Click="PauseQueue_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Pause"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton x:Name="CancelEncodeButton" Label="Stop" Click="CancelEncode_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Stop"/></AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarSeparator/>
                            <AppBarButton x:Name="ClearDraftsButton" Label="Clear queue" Click="ClearDrafts_Click" IsEnabled="False">
                                <AppBarButton.Icon><SymbolIcon Symbol="Delete"/></AppBarButton.Icon>
                            </AppBarButton>
                        </CommandBar>
                        <Grid x:Name="QueueBody" Grid.Row="2" ColumnSpacing="{StaticResource HBSpaceGroup}" SizeChanged="QueueBody_SizeChanged">
                            <Grid.ColumnDefinitions><ColumnDefinition x:Name="QueueListColumn" Width="0.65*"/><ColumnDefinition x:Name="QueueDetailColumn" Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition x:Name="QueueListRow" Height="*"/><RowDefinition x:Name="QueueDetailRow" Height="0"/></Grid.RowDefinitions>
                            <Border CornerRadius="10" BorderThickness="1" Padding="4"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <ListView x:Name="DraftQueueList" SelectionMode="Single" SelectionChanged="DraftQueueList_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnSpacing="10" Padding="6,8" ToolTipService.ToolTip="{Binding DestinationPath}">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Viewbox Width="{StaticResource HBIconSize}" Height="{StaticResource HBIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="{Binding StateIcon}" VerticalAlignment="Center"/></Viewbox>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding OutputName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding RowSummary}" FontSize="{StaticResource HBCaptionFontSize}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                            <Border x:Name="QueueDetailsCard" Grid.Column="1" CornerRadius="10" Padding="12" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid RowSpacing="{StaticResource HBSpaceRow}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <TextBlock x:Name="QueueSelectedTitle" Text="Select a job" FontSize="{StaticResource HBSectionFontSize}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True" Background="Transparent">
                            <CommandBar.Resources>
                                <ResourceDictionary Source="ms-appx:///Design/StandardCommands.xaml"/>
                            </CommandBar.Resources>
                                        <AppBarButton x:Name="EditQueueJobButton" Label="Edit" Click="EditQueueJob_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Edit"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="ResetQueueJobButton" Label="Reset / Retry" Click="ResetQueueJob_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Refresh"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MoveQueueUpButton" Label="Move up" Click="MoveQueueUp_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Up"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="MoveQueueDownButton" Label="Move down" Click="MoveQueueDown_Click" IsEnabled="False">
                                            <AppBarButton.Icon><FontIcon Glyph="&#xE74B;"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <AppBarButton x:Name="RemoveDraftButton" Label="Remove" Click="RemoveDraft_Click" IsEnabled="False">
                                            <AppBarButton.Icon><SymbolIcon Symbol="Delete"/></AppBarButton.Icon>
                                        </AppBarButton>
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton x:Name="OpenQueueSourceButton" Label="Open source in Workspace" Click="OpenQueueSource_Click" IsEnabled="False"/>
                                            <AppBarButton x:Name="OpenQueueOutputButton" Label="Open output folder" Click="OpenQueueOutput_Click" IsEnabled="False"/>
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                    <TabView x:Name="QueueDetailTabs" Grid.Row="2" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False"
                                             TabWidthMode="SizeToContent" SelectionChanged="QueueDetailTabs_SelectionChanged">
                                        <TabViewItem Header="Summary" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Spacing="{StaticResource HBSpaceGroup}" Padding="4,12">
                                                    <InfoBar x:Name="QueueJobError" IsOpen="False" IsClosable="False" Severity="Error" Title="Job needs attention"/>
                                                    <StackPanel x:Name="QueueSummaryFields" Spacing="{StaticResource HBSpaceRow}"/>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Statistics" IsClosable="False">
                                            <ScrollViewer>
                                            <StackPanel Spacing="{StaticResource HBSpaceGroup}" Padding="4,12">
                                                <ProgressBar x:Name="QueueJobProgress" Minimum="0" Maximum="100"/>
                                                <TextBlock x:Name="QueueJobStatsText" Text="No statistics available." TextWrapping="Wrap"/>
                                            </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Activity Log" IsClosable="False">
                                            <Grid RowSpacing="{StaticResource HBSpaceRow}" Padding="4,8">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                                <Button Content="Refresh log" Click="RefreshQueueLog_Click"/>
                                                <TextBox x:Name="QueueJobLogText" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                         MaxWidth="100000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                         FontFamily="Consolas" FontSize="{StaticResource HBCaptionFontSize}" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                                            </Grid>
                                        </TabViewItem>
                                    </TabView>
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel Grid.Row="3" Spacing="{StaticResource HBSpaceTight}">
                            <InfoBar x:Name="QueueStorageWarning" IsOpen="False" IsClosable="False" Severity="Warning"
                                     Title="Queue storage is unavailable"/>
                            <TextBlock x:Name="QueueStatusText" FontSize="{StaticResource HBCaptionFontSize}" TextWrapping="Wrap" Text="Add a configured source to begin."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ProgressBar x:Name="QueueEncodeProgress" Height="4" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>

                    <local:PreferencesView x:Name="SettingsPanel" Visibility="Collapsed" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <!-- Fluent source dialog: source selection stays in the Workspace context. -->
        <Grid x:Name="SourcePickerOverlay" Grid.Row="1" Visibility="Collapsed"
              Background="#77000000" Opacity="1">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="12" />
                </TransitionCollection>
            </Grid.Transitions>
            <Border MaxWidth="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel Padding="24" Spacing="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                <TextBlock Text="Add media" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="Drop media below or browse for a source." FontSize="13"
                                           TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Close" Click="CloseSourcePicker_Click"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="Close Add media" />
                        </Grid>
                        <Border MinHeight="240" Padding="24" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <Grid>
                                <Border x:Name="SourceDropFeedback" Visibility="Collapsed" IsHitTestVisible="False"
                                        Margin="-24" CornerRadius="8" BorderThickness="2"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}">
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.08" CornerRadius="6"/>
                                </Border>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{StaticResource HBSpaceRow}">
                                    <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="OpenFile" HorizontalAlignment="Center"/></Viewbox>
                                    <StackPanel Spacing="{StaticResource HBSpaceTight}">
                                        <TextBlock Text="Drop files or folders" FontSize="18" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap" />
                                        <TextBlock Text="HandBrake scans your media to detect video titles." FontSize="13"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid x:Name="SourceBrowseActions" ColumnSpacing="{StaticResource HBSpaceGroup}" RowSpacing="{StaticResource HBSpaceGroup}"
                              SizeChanged="SourceBrowseActions_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition x:Name="SourceBrowseSecondColumn" Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition x:Name="SourceBrowseSecondRow" Height="0"/>
                            </Grid.RowDefinitions>
                            <Button Click="OpenFiles_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource HBMediaSourceButtonStyle}">
                                <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="{StaticResource HBMediaSourceIconSize}" Height="{StaticResource HBMediaSourceIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="OpenFile" VerticalAlignment="Center" /></Viewbox>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Browse files" FontSize="{StaticResource HBBodyFontSize}" FontWeight="SemiBold" />
                                        <TextBlock Text="Select one or more videos" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button x:Name="SourceBrowseFolderButton" Grid.Column="1" Click="OpenFolder_Click"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Style="{StaticResource HBMediaSourceButtonStyle}">
                                <Grid ColumnSpacing="{StaticResource HBSpaceGroup}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Viewbox Width="{StaticResource HBMediaSourceIconSize}" Height="{StaticResource HBMediaSourceIconSize}" HorizontalAlignment="Center" VerticalAlignment="Center"><SymbolIcon Symbol="Folder" VerticalAlignment="Center" /></Viewbox>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="Browse folder" FontSize="{StaticResource HBBodyFontSize}" FontWeight="SemiBold" />
                                        <TextBlock Text="Scan a media folder" FontSize="13" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Hit-test transparent feedback while dragging from File Explorer. -->
        <Border x:Name="DropHighlight" Grid.Row="1" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="12" CornerRadius="12"
                BorderThickness="3" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="#330080C0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="{StaticResource HBSpaceGroup}" Margin="16">
                <SymbolIcon Symbol="OpenFile" />
                <TextBlock Text="Drop to open source"
                           FontSize="22" FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="Files and folders are supported"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
