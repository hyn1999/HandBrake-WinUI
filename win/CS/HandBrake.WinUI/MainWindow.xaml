<Window
    x:Class="HandBrake.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:HandBrake.WinUI"
    Title="HandBrake-WinUI">
    <Grid x:Name="WindowRoot" AllowDrop="True" DragOver="WindowRoot_DragOver"
          DragLeave="WindowRoot_DragLeave" Drop="WindowRoot_Drop">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="O" Modifiers="Menu" Invoked="OpenSource_AcceleratorInvoked" />
            <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="StartEncode_AcceleratorInvoked" />
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="StopEncode_AcceleratorInvoked" />
            <KeyboardAccelerator Key="Q" Modifiers="Control" Invoked="Queue_AcceleratorInvoked" />
            <KeyboardAccelerator Key="A" Modifiers="Menu" Invoked="StageQueue_AcceleratorInvoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="HandBrake"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="AppTitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/HandBrake.png" />
            </TitleBar.IconSource>
        </TitleBar>
        <NavigationView x:Name="AppNavigation" Grid.Row="1"
                        Loaded="AppNavigation_Loaded"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        PaneDisplayMode="Auto"
                        IsPaneToggleButtonVisible="False"
                        IsTitleBarAutoPaddingEnabled="False"
                        OpenPaneLength="240"
                        SelectionChanged="AppNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Workspace" Tag="workspace">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Queue" Tag="queue">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Preferences" Tag="settings">
                    <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.Content>
                <Grid Padding="16,12,16,12">
                    <Grid x:Name="HomePanel" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Top bar: source information remains visible while changing tabs. -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Workspace" FontSize="23" FontWeight="SemiBold" />
                                <TextBlock x:Name="SelectedFileText" Text="No source selected"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SelectedPathText" Text="Choose a video to begin"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" FontSize="12" />
                                <ComboBox x:Name="SourceTitlePicker"
                                          Header="Detected titles" Visibility="Collapsed"
                                          MinWidth="220" HorizontalAlignment="Left"
                                          SelectionChanged="SourceTitlePicker_SelectionChanged" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Open source" Click="ShowSourcePicker_Click"
                                    VerticalAlignment="Center" Style="{StaticResource AccentButtonStyle}" />
                            <Button x:Name="StageQueueButton" Grid.Column="2" Content="Add to queue"
                                    Click="StageQueue_Click" IsEnabled="False"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Stage the scanned title and selected native preset for encoding." />
                            <Button x:Name="PreviewToggleButton" Grid.Column="3" Content="Preview"
                                    Click="PreviewToggle_Click" Visibility="Collapsed"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Row="1" Spacing="6">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SourceStatusText"
                                           Text="Open a video, select a folder, or drop files anywhere in this window."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                                <Button x:Name="CancelScanButton" Grid.Column="1"
                                        Content="Cancel scan" Visibility="Collapsed"
                                        Click="CancelScan_Click" />
                            </Grid>
                            <ProgressBar x:Name="SourceScanProgress"
                                         Visibility="Collapsed" Minimum="0" Maximum="100"
                                         Value="0" Height="4" />
                        </StackPanel>

                        <Grid x:Name="WorkspaceGrid" Grid.Row="2" ColumnSpacing="12"
                              SizeChanged="WorkspaceGrid_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="EditorColumn" Width="*" />
                                <ColumnDefinition x:Name="PreviewColumn" Width="350" />
                            </Grid.ColumnDefinitions>

                            <!-- Editor: all HandBrake settings are visible as compact categories. -->
                            <Border x:Name="EditorPanel" Grid.Column="0"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid RowSpacing="8" Padding="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Preset" VerticalAlignment="Center"
                                                   FontWeight="SemiBold" />
                                        <ComboBox x:Name="PresetPicker" Grid.Column="1"
                                                  IsEnabled="False" HorizontalAlignment="Stretch"
                                                  SelectionChanged="PresetPicker_SelectionChanged"
                                                  AutomationProperties.Name="HandBrake encoding preset" />
                                    </Grid>

                                    <TabView Grid.Row="1" SelectionChanged="EditorTabs_SelectionChanged" IsAddTabButtonVisible="False"
                                             CanDragTabs="False" CanReorderTabs="False"
                                             TabWidthMode="SizeToContent">
                                        <TabViewItem Header="Summary" IsClosable="False">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Output summary" FontSize="17"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="ScanSummaryText"
                                                               Text="Scan a source to see actual title, duration and track counts."
                                                               TextWrapping="Wrap" />
                                                    <TextBlock x:Name="PresetStatusText"
                                                               Text="Built-in presets will load from the matching HandBrake engine."
                                                               TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Selected preset" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PresetDescriptionText"
                                                               Text="No native preset loaded." TextWrapping="Wrap" />
                                                    <TextBlock Text="Output container (from preset)" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PresetContainerText" Text="Not available" />
                                                    <TextBlock Text="This frontend is under development. Audio, subtitles, filters and dimensions do not yet reproduce all preset behavior. Review the integration status before encoding."
                                                               TextWrapping="Wrap" FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Dimensions" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Dimensions" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SourceDimensionsText"
                                                               Text="Source dimensions will appear after scanning."
                                                               TextWrapping="Wrap" />
                                                    <CheckBox x:Name="CustomGeometryToggle" Content="Override output dimensions and cropping" />
                                                    <TextBlock Text="Enter encoded pixel dimensions. Source pixel aspect ratio is retained. Re-stage the queue item after editing." TextWrapping="Wrap" />
                                                    <Grid ColumnSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <NumberBox x:Name="OutputWidthBox" Header="Width (pixels)" Minimum="2" Maximum="16384" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="OutputHeightBox" Grid.Column="1" Header="Height (pixels)" Minimum="2" Maximum="16384" SpinButtonPlacementMode="Inline" />
                                                    </Grid>
                                                    <TextBlock Text="Crop edges (source pixels)" FontWeight="SemiBold" />
                                                    <Grid ColumnSpacing="12" RowSpacing="12">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <NumberBox x:Name="CropTopBox" Header="Top" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="CropBottomBox" Grid.Column="1" Header="Bottom" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="CropLeftBox" Grid.Row="1" Header="Left" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                        <NumberBox x:Name="CropRightBox" Grid.Row="1" Grid.Column="1" Header="Right" Minimum="0" Value="0" SpinButtonPlacementMode="Inline" />
                                                    </Grid>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Filters" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Filters" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="FilterEditorStatus" Text="Filter presets and tunes require the matching native HandBrake engine." TextWrapping="Wrap" />
                                                    <StackPanel x:Name="FilterEditorPanel" Spacing="24" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Video" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Video encoding" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SourceVideoText"
                                                               Text="Source codec and frame rate will appear after scanning."
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="Video encoder" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="VideoEncoderPicker"
                                                              HorizontalAlignment="Stretch" IsEnabled="False"
                                                              SelectionChanged="VideoEncoderPicker_SelectionChanged" />
                                                    <TextBlock Text="Rate control" FontWeight="SemiBold" />
                                                    <ComboBox x:Name="VideoRateModePicker" IsEnabled="False"
                                                              HorizontalAlignment="Stretch"
                                                              SelectionChanged="VideoRateModePicker_SelectionChanged">
                                                        <ComboBoxItem Content="Constant quality" />
                                                        <ComboBoxItem Content="Average bitrate" />
                                                    </ComboBox>
                                                    <StackPanel x:Name="QualityControlPanel" Spacing="6">
                                                        <TextBlock x:Name="VideoQualityText"
                                                                   Text="Quality: not configured" />
                                                        <Slider x:Name="VideoQualitySlider"
                                                                Minimum="0" Maximum="51" Value="22"
                                                                IsEnabled="False"
                                                                ValueChanged="VideoQualitySlider_ValueChanged" />
                                                    </StackPanel>
                                                    <NumberBox x:Name="VideoBitrateBox"
                                                               Header="Average bitrate (kbps)"
                                                               Minimum="100" Maximum="200000"
                                                               Value="2500" SpinButtonPlacementMode="Inline"
                                                               Visibility="Collapsed" IsEnabled="False"
                                                               ValueChanged="VideoBitrateBox_ValueChanged" />
                                                    <TextBlock Text="Framerate and encoder tuning (from preset)"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock x:Name="PresetVideoDetailsText"
                                                               Text="Not available" TextWrapping="Wrap" />
                                                    <TextBlock x:Name="VideoConfigurationStatusText"
                                                               Text="Select a native preset and encoder to configure a queue draft."
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    <TextBlock Text="Changing the encoder or rate control updates a draft configuration only. It does not start encoding or modify HandBrake's built-in preset."
                                                               FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Audio" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Audio tracks" FontSize="17" FontWeight="SemiBold" />
                                                    <StackPanel x:Name="AudioTrackList" Spacing="8">
                                                        <TextBlock Text="Tracks will appear after scanning a source."
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <TextBlock Text="Checked tracks are included in newly staged jobs, one output per source track. Uncheck all tracks for silent output. Choose a per-track encoder and bitrate, or retain the preset audio rule. Custom encoding uses the native default mixdown and source-compatible sample rate. Passthrough, lossless and multiple outputs per track still require full rule editing." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Subtitles" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Subtitles" FontSize="17" FontWeight="SemiBold" />
                                                    <StackPanel x:Name="SubtitleTrackList" Spacing="8">
                                                        <TextBlock Text="Subtitle tracks will appear after scanning."
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Button Content="Import SRT files" Click="ImportSubtitle_Click" HorizontalAlignment="Left" />
                                                    <TextBlock x:Name="SubtitleImportStatus" Text="UTF-8 SRT soft subtitles support MP4 and MKV. At most one internal or imported track may be burned into video." TextWrapping="Wrap" />
                                                    <StackPanel x:Name="ImportedSubtitleList" Spacing="16" />
                                                    <TextBlock Text="Select internal subtitle tracks to include. Soft subtitles require a compatible container. Burn-in is permanent in the output image and cannot be switched off during playback. Foreign-audio search is pending. Re-stage the queue entry after editing." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Chapters" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Chapters" FontSize="17" FontWeight="SemiBold" />
                                                    <CheckBox x:Name="ChapterMarkersToggle" Content="Create chapter markers" IsChecked="True" />
                                                    <TextBlock x:Name="ChapterListText"
                                                               Text="Chapter titles will appear here after source scanning."
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                        <TabViewItem Header="Metadata" IsClosable="False">
                                            <ScrollViewer>
                                                <StackPanel Padding="12,16,12,16" Spacing="16">
                                                    <TextBlock Text="Metadata" FontSize="17" FontWeight="SemiBold" />
                                                    <TextBlock Text="Overrides apply to newly staged jobs. Leave a field empty to retain source metadata." TextWrapping="Wrap" />
                                                    <TextBox x:Name="MetadataTitleBox" Header="Title" />
                                                    <TextBox x:Name="MetadataArtistBox" Header="Artist" />
                                                    <TextBox x:Name="MetadataAlbumBox" Header="Album" />
                                                    <TextBox x:Name="MetadataCommentBox" Header="Comment" AcceptsReturn="True" TextWrapping="Wrap" />
                                                    <TextBlock Text="Additional metadata will be available after scanning."
                                                               TextWrapping="Wrap" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </TabViewItem>
                                    </TabView>
                                </Grid>
                            </Border>

                            <!-- Fixed right-hand preview, with a narrow-window fallback. -->
                            <Border x:Name="PreviewPanel" Grid.Column="1"
                                    CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid Padding="12" RowSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Preview" FontSize="17" FontWeight="SemiBold" />
                                    <Grid Grid.Row="1" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                CornerRadius="8" Height="220" VerticalAlignment="Top">
                                            <Grid>
                                                <Image x:Name="PreviewFrame" Stretch="Uniform"
                                                       Visibility="Collapsed" />
                                                <StackPanel x:Name="PreviewPlaceholder"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Spacing="8" Margin="16">
                                                    <SymbolIcon Symbol="Pictures" />
                                                    <TextBlock x:Name="PreviewPlaceholderText"
                                                               Text="Choose a source to decode a real frame"
                                                               TextWrapping="Wrap" TextAlignment="Center" />
                                                    <TextBlock Text="Decoded by the native HandBrake engine"
                                                               TextWrapping="Wrap" TextAlignment="Center"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid Grid.Row="1" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PreviousPreviewButton" Content="Previous frame"
                                                    IsEnabled="False" Click="PreviousPreview_Click" />
                                            <TextBlock x:Name="PreviewFrameCounterText" Grid.Column="1"
                                                       Text="No frame" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="NextPreviewButton" Grid.Column="2"
                                                    Content="Next frame" IsEnabled="False"
                                                    Click="NextPreview_Click" />
                                        </Grid>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Spacing="6">
                                        <TextBlock Text="Source details" FontWeight="SemiBold" />
                                        <TextBlock x:Name="PreviewSourceText" Text="No source selected"
                                                   TextWrapping="Wrap" />
                                        <TextBlock x:Name="PreviewMetadataText"
                                                   Text="Scan a video to display its properties."
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Persistent action bar for the active native encode queue. -->
                        <Border Grid.Row="3" CornerRadius="10" Padding="10"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="Destination" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="Choose a source to prepare an output filename"
                                               TextTrimming="CharacterEllipsis"
                                               x:Name="DestinationText" />
                                </StackPanel>
                                <Button x:Name="StartEncodeButton" Grid.Column="1" Content="Start Encode"
                                        IsEnabled="False" Click="StartEncode_Click"
                                        Style="{StaticResource AccentButtonStyle}"
                                        ToolTipService.ToolTip="Encode configured queue items with the native HandBrake engine." />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="QueuePanel" Visibility="Collapsed" RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Queue" FontSize="23" FontWeight="SemiBold" />
                            <TextBlock x:Name="QueueCountText" Text="No staged sources"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <InfoBar Grid.Row="1" IsOpen="True" IsClosable="False"
                                 Severity="Informational" Title="Native encode queue"
                                 Message="Configured items are validated and processed sequentially by the matching HandBrake engine. Scan a title and choose a native preset before staging a job." />
                        <Border Grid.Row="2" CornerRadius="10" Padding="8"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <ListView x:Name="DraftQueueList" SelectionMode="Single"
                                      SelectionChanged="DraftQueueList_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Spacing="4" Padding="6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SourcePath}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding ConfigurationSummary}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding DestinationSummary}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Border>
                        <Grid Grid.Row="3" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock x:Name="QueueStatusText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Choose a scanned title and native preset, then add it to the queue." />
                                <ProgressBar x:Name="QueueEncodeProgress" Height="4" Minimum="0"
                                             Maximum="100" Value="0" Visibility="Collapsed" />
                            </StackPanel>
                            <Button x:Name="RemoveDraftButton" Grid.Column="1"
                                    Content="Remove selected" IsEnabled="False"
                                    Click="RemoveDraft_Click" />
                            <Button x:Name="ClearDraftsButton" Grid.Column="2"
                                    Content="Clear queue" IsEnabled="False"
                                    Click="ClearDrafts_Click" />
                            <Button x:Name="CancelEncodeButton" Grid.Column="3"
                                    Content="Stop" IsEnabled="False"
                                    Click="CancelEncode_Click" />
                            <Button x:Name="StartQueueEncodeButton" Grid.Column="4"
                                    Content="Start Encode" IsEnabled="False"
                                    Click="StartEncode_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </Grid>

                    <local:PreferencesView x:Name="SettingsPanel" Visibility="Collapsed" />
                </Grid>
            </NavigationView.Content>
        </NavigationView>
        <!-- Fluent source dialog: source selection stays in the Workspace context. -->
        <Grid x:Name="SourcePickerOverlay" Grid.Row="1" Visibility="Collapsed"
              Background="#77000000" Opacity="1">
            <Grid.Transitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="12" />
                </TransitionCollection>
            </Grid.Transitions>
            <Border MaxWidth="760" Margin="24" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                    <StackPanel Padding="24" Spacing="24">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Add media" Style="{ThemeResource TitleTextBlockStyle}" />
                                <TextBlock Text="Drop media below or browse for a source." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Close" Click="CloseSourcePicker_Click" VerticalAlignment="Top" />
                        </Grid>
                        <Border MinHeight="240" Padding="24" CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                                <FontIcon Glyph="&#xE896;" FontSize="40" HorizontalAlignment="Center" />
                                <TextBlock Text="Drop files or folders here" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Text="HandBrake scans your media to detect video titles." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Click="OpenFiles_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="OpenFile" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Browse files" FontWeight="SemiBold" />
                                        <TextBlock Text="Select one or more videos" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Click="OpenFolder_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <SymbolIcon Symbol="Folder" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Browse folder" FontWeight="SemiBold" />
                                        <TextBlock Text="Scan a media folder" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Hit-test transparent feedback while dragging from File Explorer. -->
        <Border x:Name="DropHighlight" Grid.Row="1" Visibility="Collapsed"
                IsHitTestVisible="False" Margin="12" CornerRadius="12"
                BorderThickness="3" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                Background="#330080C0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="12" Margin="16">
                <SymbolIcon Symbol="OpenFile" />
                <TextBlock Text="Drop to open source"
                           FontSize="22" FontWeight="SemiBold"
                           TextAlignment="Center" />
                <TextBlock Text="Files and folders are supported"
                           TextAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
