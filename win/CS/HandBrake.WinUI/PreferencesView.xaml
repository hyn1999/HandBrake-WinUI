<UserControl
    x:Class="HandBrake.WinUI.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="PreferencesView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="PreferencesCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="CategoryColumn" Width="184" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Secondary navigation is scoped to Preferences, not a WPF-style window. -->
        <Border x:Name="CategorySidebar" Grid.Column="0"
                CornerRadius="10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" Padding="6">
            <ListView x:Name="CategoryList" SelectionMode="Single"
                      SelectionChanged="CategoryList_SelectionChanged"
                      HorizontalContentAlignment="Stretch">
                <ListViewItem Content="General" />
                <ListViewItem Content="Output Files" />
                <ListViewItem Content="When Done" />
                <ListViewItem Content="Video" />
                <ListViewItem Content="Advanced" />
                <ListViewItem Content="Updates" />
                <ListViewItem Content="Reset" />
                <ListViewItem Content="About HandBrake" />
            </ListView>
        </Border>

        <Grid Grid.Column="1" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="Preferences" FontSize="23" FontWeight="SemiBold" />
                <ComboBox x:Name="CompactCategoryPicker"
                          Visibility="Collapsed" HorizontalAlignment="Stretch"
                          SelectionChanged="CompactCategoryPicker_SelectionChanged">
                    <ComboBoxItem Content="General" />
                    <ComboBoxItem Content="Output Files" />
                    <ComboBoxItem Content="When Done" />
                    <ComboBoxItem Content="Video" />
                    <ComboBoxItem Content="Advanced" />
                    <ComboBoxItem Content="Updates" />
                    <ComboBoxItem Content="Reset" />
                    <ComboBoxItem Content="About HandBrake" />
                </ComboBox>
                <TextBlock x:Name="PreferencesStatusText" FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Changes are saved automatically on this device."
                           TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid Padding="0,6,8,16">
                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Spacing="12">
                        <TextBlock Text="General" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox x:Name="ThemePicker" Header="App theme"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AnyCombo_SelectionChanged">
                                    <ComboBoxItem Content="Match Windows" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                                <ToggleSwitch x:Name="ShowPreviewToggle"
                                              Header="Show preview panel in Workspace"
                                              Toggled="AnyToggle_Toggled" />
                                <TextBlock Text="The preview currently shows source information, not decoded video frames."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Language &amp; interface" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox Header="Display language" IsEnabled="False"
                                          SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Use system language (localization planned)" />
                                </ComboBox>
                                <TextBlock Text="Language switching and right-to-left localization require translated WinUI resources and will be enabled later."
                                           TextWrapping="Wrap" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Output files -->
                    <StackPanel x:Name="OutputPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Output Files" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Default destination" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="OutputFolderText"
                                           Text="No default folder selected"
                                           TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Choose folder" Click="BrowseOutputFolder_Click" />
                                    <Button Content="Use source folder" Click="ClearOutputFolder_Click" />
                                </StackPanel>
                                <TextBlock Text="This location is used for the suggested destination filename. Saving and encoding are not available yet."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Filename suggestions" FontSize="16" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="ReplaceUnderscoresToggle"
                                              Header="Replace underscores with spaces"
                                              Toggled="AnyToggle_Toggled" />
                                <ComboBox x:Name="ExtensionPicker"
                                          Header="Suggested MP4 file extension"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AnyCombo_SelectionChanged">
                                    <ComboBoxItem Content=".mp4" />
                                    <ComboBoxItem Content=".m4v" />
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- When done -->
                    <StackPanel x:Name="WhenDonePage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="When Done" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="After encoding" FontSize="16" FontWeight="SemiBold" />
                                <ComboBox Header="When the queue completes"
                                          SelectedIndex="0" IsEnabled="False"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Do nothing" />
                                </ComboBox>
                                <TextBlock Text="Shutdown, sleep, notifications and custom actions will be connected after the real encode queue is available. No system action will be triggered by this preview."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Video / scanning -->
                    <StackPanel x:Name="VideoPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Video" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Source scanning" FontSize="16" FontWeight="SemiBold" />
                                <NumberBox x:Name="ScanPreviewCountBox"
                                           Header="Preview samples per title"
                                           Minimum="1" Maximum="60" Value="10"
                                           SpinButtonPlacementMode="Inline"
                                           ValueChanged="ScanNumber_ValueChanged" />
                                <NumberBox x:Name="MinimumDurationBox"
                                           Header="Minimum title duration (seconds)"
                                           Minimum="0" Maximum="3600" Value="0"
                                           SpinButtonPlacementMode="Inline"
                                           ValueChanged="ScanNumber_ValueChanged" />
                                <TextBlock Text="These values are passed directly to the HandBrake source scanner on the next scan."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Advanced -->
                    <StackPanel x:Name="AdvancedPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Advanced" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Scanner behavior" FontSize="16" FontWeight="SemiBold" />
                                <ToggleSwitch x:Name="KeepDuplicateTitlesToggle"
                                              Header="Keep duplicate titles"
                                              Toggled="AnyToggle_Toggled" />
                                <ComboBox x:Name="ScanVerbosityPicker"
                                          Header="Native scan log detail"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="AnyCombo_SelectionChanged">
                                    <ComboBoxItem Content="Quiet" />
                                    <ComboBoxItem Content="Normal" />
                                    <ComboBoxItem Content="Verbose" />
                                </ComboBox>
                                <TextBlock Text="Log detail changes apply after restarting the app; duplicate-title changes apply on the next scan."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Display diagnostics" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="DpiStatusText" Text="WinUI rendering scale: detecting..."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel x:Name="UpdatesPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Development builds" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Automatic update checking is not available in this unpackaged WinUI preview. Test builds are created manually in GitHub Actions to avoid unnecessary downloads."
                                           TextWrapping="Wrap" />
                                <HyperlinkButton Content="Open project builds"
                                                 NavigateUri="https://github.com/hyn1999/HandBrake-WinUI/actions"
                                                 HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Reset -->
                    <StackPanel x:Name="ResetPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="Reset" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Restore default preferences"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Reset only this WinUI frontend's preferences. The original HandBrake WPF settings, source files and presets are not changed."
                                           TextWrapping="Wrap" />
                                <Button Content="Restore defaults" Click="ResetPreferences_Click"
                                        HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="AboutPage" Visibility="Collapsed" Spacing="12">
                        <TextBlock Text="About HandBrake" FontSize="20" FontWeight="SemiBold" />
                        <Border Style="{StaticResource PreferencesCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="HandBrake · WinUI 3 Preview"
                                           FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="A modern Windows 11 frontend for the existing HandBrake engine. This preview is under active development."
                                           TextWrapping="Wrap" />
                                <TextBlock Text="The original WPF application and libhb encoder are not replaced."
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="AboutDpiText"
                                           Text="WinUI rendering scale: detecting..."
                                           TextWrapping="Wrap" />
                                <HyperlinkButton Content="Project repository"
                                                 NavigateUri="https://github.com/hyn1999/HandBrake-WinUI"
                                                 HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

