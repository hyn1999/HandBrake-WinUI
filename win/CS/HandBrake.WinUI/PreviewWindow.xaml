<Window
    x:Class="HandBrake.WinUI.PreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="HandBrake — Preview">
    <Grid x:Name="PreviewRoot" Padding="12" RowSpacing="12"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="FrameViewport" SizeChanged="FrameViewport_SizeChanged" MinWidth="0" MinHeight="0">
            <Image x:Name="FrameImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <TextBlock x:Name="FramePlaceholder" Text="No decoded frame available."
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="PreviousButton" Click="Previous_Click" IsEnabled="False"
                    AutomationProperties.Name="Previous preview frame" ToolTipService.ToolTip="Previous frame">
                <SymbolIcon Symbol="Back"/>
            </Button>
            <TextBlock x:Name="FrameStatus" Grid.Column="1" Text="No frame" VerticalAlignment="Center"
                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <Button x:Name="NextButton" Grid.Column="2" Click="Next_Click" IsEnabled="False"
                    AutomationProperties.Name="Next preview frame" ToolTipService.ToolTip="Next frame">
                <SymbolIcon Symbol="Forward"/>
            </Button>
            <Button Grid.Column="3" Content="Close" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
